rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// ADMIN_EMAILS: each admin username + "@users.quiz.lakhshit.in" (must match config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'admin@users.quiz.lakhshit.in'
      ];
    }
    function isApproved() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // One profile per account. New sign-ups can only create themselves as "pending".
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'name', 'email', 'status', 'createdAt'])
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (request.resource.data.status == 'pending' || (isAdmin() && request.resource.data.status == 'approved'));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'pending', 'rejected'];
      allow delete: if isAdmin();
    }

    // Quiz results. Only approved people can save, only for themselves; nobody can edit a score.
    match /attempts/{id} {
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.score <= request.resource.data.total;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
